#!/bin/sh
# Run by sshd on login. Keeps a stable agent socket path so tmux sessions
# survive reconnects (tmux.conf points SSH_AUTH_SOCK here). Only repointed when
# the current target is gone: every scp/rsync/command session runs this too,
# and its socket disappears as soon as it ends.
if [ -n "$SSH_AUTH_SOCK" ] && [ ! -S "$HOME/.ssh/ssh_auth_sock" ]; then
    ln -sf "$SSH_AUTH_SOCK" "$HOME/.ssh/ssh_auth_sock"
fi

# sshd skips its own xauth handling when ~/.ssh/rc exists (see sshd(8))
if read -r proto cookie && [ -n "$DISPLAY" ]; then
    if [ "$(echo "$DISPLAY" | cut -c1-10)" = 'localhost:' ]; then
        echo "add unix:$(echo "$DISPLAY" | cut -c11-) $proto $cookie"
    else
        echo "add $DISPLAY $proto $cookie"
    fi | xauth -q -
fi
