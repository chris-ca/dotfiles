# Shared defaults only. Host entries (names, IPs, users, keys) live per host
# in ~/.ssh/config.d/ and are not tracked.
# ssh uses the first value it finds, so the Include must come first to let
# host entries override the defaults below.
Include ~/.ssh/config.d/*

Host *
    ServerAliveInterval 60
    ServerAliveCountMax 3
    AddKeysToAgent yes
    # Reuse one connection for repeated ssh/scp/git to the same host
    ControlMaster auto
    ControlPath ~/.ssh/cm-%C
    ControlPersist 10m
