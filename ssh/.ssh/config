# Shared defaults only. Host entries (names, IPs, users, keys) live per host
# in ~/.ssh/config.d/ and are not tracked.
# ssh uses the first value it finds, so the Include must come first to let
# host entries override the defaults below.
Include ~/.ssh/config.d/*

# Before reusing a connection, check that it still answers and drop it if
# not, so a master left over from before a sleep or network change can't hang
# ssh/scp/git. Never matches; it only runs for that side effect. Skipped
# when the bin package isn't installed (or install.sh wasn't re-run).
Match exec "test -x ~/.local/bin/ssh-mux-probe && ~/.local/bin/ssh-mux-probe %C"

Host *
    # Connected or failed within 10s: 2s probe above + 7s connect/handshake
    ConnectTimeout 7
    ServerAliveInterval 15
    ServerAliveCountMax 3
    AddKeysToAgent yes
    # Reuse one connection for repeated ssh/scp/git to the same host
    ControlMaster auto
    ControlPath ~/.ssh/cm-%C
    ControlPersist 10m
